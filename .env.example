NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Provider email: resend, smtp, sendgrid
EMAIL_PROVIDER=resend

# Resend
RESEND_API_KEY=re_xxxxxxxxx

# SMTP generic. Works with many providers: Gmail Workspace SMTP relay, Mailgun SMTP,
# SendGrid SMTP, Amazon SES SMTP, Brevo SMTP, Zoho SMTP, Postmark SMTP, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# SendGrid API
SENDGRID_API_KEY=SG.xxxxxxxxx

DEFAULT_FROM_EMAIL=no-reply@your-verified-domain.com

# App runtime
NEXT_PUBLIC_APP_URL=http://localhost:3000
