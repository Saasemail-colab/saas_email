NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres.your-project:your-database-password@aws-0-region.pooler.supabase.com:6543/postgres
# Alternative names accepted by the automatic setup endpoint:
# DIRECT_URL=postgresql://postgres.your-project:your-database-password@aws-0-region.pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql://postgres.your-project:your-database-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Admin
ADMIN_ACCESS_CODE=change-this-admin-code
ADMIN_SESSION_SECRET=change-this-long-random-session-secret

# Provider email: auto, gmail_smtp, gmail_oauth, resend
EMAIL_PROVIDER=auto

# Gmail SMTP simple, sans OAuth. Utilise un mot de passe d'application Google.
GMAIL_SMTP_USER=your-gmail@gmail.com
GMAIL_SMTP_PASS=your-google-app-password

# Resend
RESEND_API_KEY=re_xxxxxxxxx

# Gmail OAuth multi-comptes
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
GOOGLE_REDIRECT_URI=https://saas-email-gk0j.onrender.com/api/oauth/google/callback
GOOGLE_OAUTH_STATE_SECRET=change-this-long-random-state-secret
CREDENTIAL_ENCRYPTION_KEY=change-this-long-random-secret-at-least-24-chars

DEFAULT_FROM_EMAIL=no-reply@your-verified-domain.com

# App runtime
NEXT_PUBLIC_APP_URL=https://saas-email-gk0j.onrender.com
NEXT_PUBLIC_DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
