NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Provider email: auto, resend, smtp, sendgrid, mailgun, postmark, brevo, mailersend
EMAIL_PROVIDER=auto

# Resend
RESEND_API_KEY=re_xxxxxxxxx

# SMTP generic. Works with many providers: Gmail Workspace SMTP relay, Mailgun SMTP,
# SendGrid SMTP, Amazon SES SMTP, Brevo SMTP, Zoho SMTP, Postmark SMTP, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# SendGrid API
SENDGRID_API_KEY=SG.xxxxxxxxx

# Mailgun API
MAILGUN_API_KEY=key-xxxxxxxxx
MAILGUN_DOMAIN=mg.your-verified-domain.com
MAILGUN_BASE_URL=https://api.mailgun.net

# Postmark API
POSTMARK_SERVER_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Brevo API
BREVO_API_KEY=xkeysib-xxxxxxxxx

# MailerSend API
MAILERSEND_API_KEY=mlsn.xxxxxxxxx

# Gmail OAuth multi-comptes
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
GOOGLE_OAUTH_STATE_SECRET=change-this-long-random-state-secret
CREDENTIAL_ENCRYPTION_KEY=change-this-long-random-secret-at-least-24-chars

DEFAULT_FROM_EMAIL=no-reply@your-verified-domain.com

# App runtime
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
